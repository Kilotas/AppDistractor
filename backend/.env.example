# Скопируй в .env и заполни. docker compose читает .env из корня репозитория,
# локальный запуск бэкенда (uvicorn из backend/) — backend/.env.
# Пустые значения = фича выключена, приложение всё равно запускается.

# ── Основное ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./focus.db
CORS_ORIGINS=["http://localhost:5173","chrome-extension://*"]
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30
APP_URL=http://localhost:5173

# ── Email (приоритет: Яндекс SMTP → Resend → только лог) ──
YANDEX_SMTP_USER=
YANDEX_SMTP_PASSWORD=
YANDEX_SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=FocusVoid <noreply@focusvoid.com>

# ── AI-анализ задач (GET /tasks/{id}/insights) ────────
ANTHROPIC_API_KEY=

# ── Оплата (LemonSqueezy) ─────────────────────────────
PAYMENT_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
